{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "name": "workbench dev",
      "request": "launch",
      "url": "http://localhost:5700",
      "env": { "NODE_ENV": "development" },
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}/apps/web-workbench"
    },
    {
      "type": "chrome",
      "name": "console dev",
      "request": "launch",
      "url": "http://localhost:5700",
      "env": { "NODE_ENV": "development" },
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}/apps/web-console"
    },
    {
      "type": "chrome",
      "name": "open dev",
      "request": "launch",
      "url": "http://localhost:5700",
      "env": { "NODE_ENV": "development" },
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}/apps/web-open"
    }
  ]
}
