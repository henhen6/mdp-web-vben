# 应用标题
VITE_APP_TITLE=主数据平台

VITE_BASE=/

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=mdp

# 请求头中携带的token(用户身份信息) key名称
VITE_GLOB_TOKEN_KEY=token

# 当前应用ID
VITE_GLOB_APP_ID=1
# 客户端id
VITE_GLOB_APP_KEY=web-workbench

# 后端架构
VITE_GLOB_MODE=boot

# axios 请求默认超时间： 10s
VITE_GLOB_AXIOS_TIMEOUT=10000

# 使用百度统计
VITE_USE_BAIDU_STATISTICS=true

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key-mdp

# vue-router 的模式
VITE_ROUTER_HISTORY=hash
