# 端口号
VITE_PORT=7700

# 接口地址
VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 使用百度统计
VITE_USE_BAIDU_STATISTICS=false

# 本地启动时，代理地址
VITE_PROXY=`{
"cloud": [{
  "proxyKey": "/api",
  "rewriteBefore": "/api",
  "rewriteAfter": "/api",
  "target": "http://localhost:7800"
}],
"boot": [{
  "proxyKey": "/api",
  "rewriteBefore": "/api/[A-Za-z0-9]+",
  "rewriteAfter": "",
  "target": "http://localhost:7800"
}]
}`
