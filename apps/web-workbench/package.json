  "type": "module",
  "scripts": {
    "build": "pnpm vite build --mode production",
    "build:boot": "pnpm cross-env VITE_GLOB_MODE=boot vite build --mode production",
    "build:cloud": "pnpm cross-env VITE_GLOB_MODE=cloud vite build --mode production",
    "build:analyze": "pnpm vite build --mode analyze",
    "dev": "pnpm cross-env vite --mode development",
    "dev:boot": "pnpm cross-env VITE_GLOB_MODE=boot vite --mode development",
    "dev:cloud": "pnpm cross-env VITE_GLOB_MODE=cloud vite --mode development",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
